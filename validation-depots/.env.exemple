# Copiez ce fichier en .env. Générez un secret long et aléatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JETON_INTERNE=remplacez-moi-par-un-secret-aleatoire
# Secret d'amorçage : ne sert qu'à créer le premier superviseur (POST /admin/amorcage), une seule fois.
# Ensuite, chaque membre de l'équipe a son propre compte et son propre jeton. Différent de JETON_INTERNE.
JETON_AMORCAGE=remplacez-moi-par-un-autre-secret-aleatoire

# Secret partagé entre le front web et la plateforme. Il permet au front de transmettre l'adresse de chaque utilisateur
# pour que les limites anti-abus (inscriptions, codes SMS) s'appliquent par utilisateur et non à tout le site.
# Différent des deux autres.
JETON_BFF=remplacez-moi-par-un-troisieme-secret-aleatoire

# Sites web autorisés à appeler la plateforme depuis un navigateur (CORS), séparés par des virgules.
# Vide par défaut : aucun. Utile seulement pour l'application mobile servie en web ; l'application native n'en a pas besoin.
# ORIGINES_AUTORISEES=https://app.exemple.cd

# --- Envoi des SMS ---------------------------------------------------------
# journal : les SMS sont écrits dans le journal du conteneur, rien n'est envoyé (par défaut).
# africastalking ou twilio : envoi réel. Commencez par l'environnement de test du fournisseur.
FOURNISSEUR=journal
# Identifiant d'expéditeur (nom court ou numéro), à faire valider par le fournisseur et les opérateurs.
# Obligatoire pour Twilio (numéro +... ou service MG...), facultatif pour Africa's Talking.
SMS_EXPEDITEUR=
# Nombre maximal de SMS par jour (UTC). Vide : pas de plafond. Au-delà, les SMS attendent le lendemain.
SMS_PLAFOND_JOUR=500

# Africa's Talking : AT_USERNAME=sandbox pour l'environnement de test (aucun SMS réel).
AT_USERNAME=
AT_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Interface web ---------------------------------------------------------
# 1 dès que le site est servi en HTTPS : le cookie de session n'est alors envoyé qu'en HTTPS.
COOKIE_SECURE=0
